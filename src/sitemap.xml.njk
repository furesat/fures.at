  {% endfor %}
  {% for post in blogPosts.all | default([]) %}
  <url>
    <loc>https://fures.at/{{ post.lang }}/blog/{{ post.slug }}</loc>
    <lastmod>{{ post.date | sitemapDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  {% for campaign in campaignPosts.all | default([]) %}
